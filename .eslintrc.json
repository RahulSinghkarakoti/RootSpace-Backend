{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off",
    "prefer-const": "warn",
    "no-var": "warn",
    "semi": ["warn", "always"],
    // "quotes": ["warn", "single"],
    "quotes": "off",
    "indent": ["warn", 2],
    "comma-dangle": ["warn", "always-multiline"]
  },
  "ignorePatterns": [
    "node_modules/",
    "logs/",
    "dist/",
    "coverage/",
    "test-results/",
    "*.log"
  ]
}