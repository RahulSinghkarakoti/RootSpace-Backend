# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ── PostgreSQL (Prisma) ──────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/auth_db?schema=public"

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_another_64_char_random_hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── OAuth2 — Google ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated — add your React Native dev URLs / production domains
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,exp://localhost:19000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=AuthServer
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ── Email & Password Reset ───────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
PASSWORD_RESET_SECRET=replace_with_another_64_char_random_hex
RESET_TOKEN_EXPIRY_HOURS=2

# ── Future: OCR / LLM ────────────────────────────────────────────────────────
# OPENAI_API_KEY=
# OCR_API_KEY=
