// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum OAuthProvider {
  GOOGLE
  APPLE
  FACEBOOK
}

enum BillStatus {
  QUEUED
  OCR_PROCESSING
  OCR_COMPLETED
  PARSING
  PARSED
  REVIEWING
  SAVED
  FAILED
}

enum BillSource {
  IMAGE
  MANUAL
  UPI_SHARE
  PDF
}

// ── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")   // null for OAuth-only accounts
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  avatarUrl    String?  @map("avatar_url")
  role         Role     @default(USER)
  isVerified   Boolean  @default(false) @map("is_verified")
  isActive     Boolean  @default(true)  @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt      @map("updated_at")

  // Relations
  oauthProviders    OAuthProviderRecord[]
  refreshTokens     RefreshToken[]
  emailVerifications EmailVerification[]
  passwordResets    PasswordReset[]
  auditLogs         AuditLog[]
  bills             Bills[]

  @@map("users")
}

model OAuthProviderRecord {
  id           Int           @id @default(autoincrement())
  userId       String        @map("user_id")
  provider     OAuthProvider
  providerId   String        @map("provider_id")
  accessToken  String?       @map("access_token")
  refreshToken String?       @map("refresh_token")
  tokenExpires DateTime?     @map("token_expires")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt      @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("oauth_providers")
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")  // SHA-256 hash of raw token
  deviceInfo String?   @map("device_info")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  revoked    Boolean   @default(false)
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("email_verifications")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_resets")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?  @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Bills {
  id            BigInt      @id @default(autoincrement())
  userId        String     @map("user_id")
  source        BillSource
  status        BillStatus  @default(QUEUED)
  fileId        BigInt?     @unique @map("file_id")

  // searchable bill fields
  merchantName  String?     @map("merchant_name")
  totalAmount   Float?      @map("total_amount")
  billDate      DateTime?   @map("bill_date")
  currency      String?     @map("currency")

  // retry system
  retryCount    Int         @default(0) @map("retry_count")
  lastError     String?     @map("last_error")

  // worker locking
  workerId      String?     @map("worker_id")
  lockedAt      DateTime?   @map("locked_at")
  
  // pipeline timestamps
  ocrStartedAt     DateTime? @map("ocr_started_at")
  ocrCompletedAt   DateTime? @map("ocr_completed_at")
  parsedAt         DateTime? @map("parsed_at")
  reviewedAt       DateTime? @map("reviewed_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt      @map("updated_at")
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  file          BillFiles?  @relation(fields: [fileId], references: [id])
  ocr           BillOCR?
  parsed        BillParsed?
  final         BillFinal?

  @@index([status])
  @@index([status, createdAt])
  @@index([userId])
  @@index([merchantName])
  @@map("bills")
}

model BillFiles {
  id           BigInt   @id @default(autoincrement())
  fileUrl      String   @map("file_url")
  cloudinaryId String?  @map("cloudinary_id")
  fileType     String   @map("file_type")
  fileSize     Int?     @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")
  bill         Bills?
  @@map("bill_files")
}

model BillOCR {
  id           BigInt   @id @default(autoincrement())
  billId       BigInt   @unique @map("bill_id")
  rawText      Json?    @map("raw_text")
  confidence   Float?   @map("confidence")
  processedAt  DateTime? @map("processed_at")
  bill         Bills @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_ocr")
}

model BillParsed {
  id          BigInt   @id @default(autoincrement())
  billId      BigInt   @unique @map("bill_id")
  parsedData  Json?
  parsedAt    DateTime? @map("parsed_at")
  bill        Bills @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_parsed")
}

model BillFinal {
  id          BigInt   @id @default(autoincrement())
  billId      BigInt   @unique @map("bill_id")
  finalData   Json?
  verifiedBy  BigInt?  @map("verified_by")
  verifiedAt  DateTime? @map("verified_at")
  bill        Bills @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@map("bill_final")
}

model BillErrors {
  id        BigInt   @id @default(autoincrement())
  billId    BigInt   @map("bill_id")
  stage     String
  message   String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([billId])
  @@map("bill_errors")
}